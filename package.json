{
  "name": "ecgbc-registration",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:backend": "pnpm --filter @ecgbc/backend run dev",
    "dev:admin": "pnpm --filter @ecgbc/admin-portal run dev",
    "dev:church": "pnpm --filter @ecgbc/church-portal run dev",
    "build": "pnpm --filter @ecgbc/backend run build && pnpm --filter @ecgbc/admin-portal run build && pnpm --filter @ecgbc/church-portal run build",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "dependencies": {
    "framer-motion": "^12.42.2"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "dompurify": ">=3.4.17",
      "handlebars": ">=4.7.10",
      "shell-quote": ">=1.11.0",
      "follow-redirects": ">=1.16.2",
      "body-parser": ">=1.20.9"
    }
  }
}
